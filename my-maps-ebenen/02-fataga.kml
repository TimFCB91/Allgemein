    <Placemark>
      <name>Mirador de la Degollada de las Yeguas</name>
      <description><![CDATA[<b>Etappe 2 · Fataga-Tal · Tag 3</b><br/>Aussichtspunkt über die Schlucht, der „Grand Canyon von Gran Canaria“. Erster großer Blick auf der Auffahrt.]]></description>
      <styleUrl>#fataga</styleUrl>
      <Point><coordinates>-15.579300,27.819300,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Arteara (Palmenhain &amp; Necrópolis)</name>
      <description><![CDATA[<b>Etappe 2 · Fataga-Tal · Tag 3</b><br/>Ausgedehnter Palmenhain im Barranco de Fataga, dazu eine alte Ureinwohner-Nekropole.]]></description>
      <styleUrl>#fataga</styleUrl>
      <Point><coordinates>-15.585600,27.834700,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Fataga</name>
      <description><![CDATA[<b>Etappe 2 · Fataga-Tal · Tag 3</b><br/>Hübsches weißes Bergdorf im „Tal der tausend Palmen“. Gute erste Mittagspause.]]></description>
      <styleUrl>#fataga</styleUrl>
      <Point><coordinates>-15.583600,27.850600,0</coordinates></Point>
    </Placemark>
