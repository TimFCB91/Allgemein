  <Document>
    <name>Etappe 5 · Norden</name>
    <Style id="norden">
      <IconStyle><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/purple-pushpin.png</href></Icon></IconStyle>
