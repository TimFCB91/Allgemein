<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Gran Canaria Rundreise (7–10 Tage)</name>
    <description>Alle Orte aus dem Blog-Beitrag, sortiert nach Etappen.</description>
